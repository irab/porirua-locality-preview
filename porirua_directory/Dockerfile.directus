# Custom Directus image with the Directory editor module + endpoint.
# Pin only in clusters/dev/tenants/porirua-directory — never prod from this task.
FROM node:22-bookworm-slim AS extension-build
WORKDIR /ext
COPY directus/extensions/directory-editor/package.json directus/extensions/directory-editor/package-lock.json ./
RUN npm ci
COPY directus/extensions/directory-editor/ ./
RUN npm run build

FROM directus/directus:11.9.3
USER root
COPY --from=extension-build /ext/package.json /directus/extensions/directus-extension-directory-editor/package.json
COPY --from=extension-build /ext/dist /directus/extensions/directus-extension-directory-editor/dist
USER node
