# Payload Directory admin. Pin only in clusters/dev — never prod from this task.
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY payload/package.json payload/package-lock.json ./payload/
RUN cd payload && npm ci

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY --from=deps /app/payload/node_modules ./payload/node_modules
COPY editor-core ./editor-core
COPY config-directory.js ./config-directory.js
COPY payload ./payload
WORKDIR /app/payload
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app/editor-core ./editor-core
COPY --from=build /app/config-directory.js ./config-directory.js
COPY --from=build /app/payload ./payload
WORKDIR /app/payload
EXPOSE 3000
CMD ["npm", "run", "start"]
