{
  "name": "Review queue actions",
  "icon": "rule",
  "color": "#5B2D8E",
  "description": "Approve, edit-and-approve, hide, or reject a pending_review / review_queue_items row.",
  "status": "active",
  "accountability": "all",
  "trigger": "webhook",
  "options": {
    "method": "POST"
  },
  "operation": "route_action",
  "operations": [
    {
      "identifier": "route_action",
      "name": "Dispatch review action",
      "key": "route_action",
      "type": "request",
      "position_x": 19,
      "position_y": 17,
      "options": {
        "method": "POST",
        "url": "http://operations:8790/{{$trigger.body.action}}",
        "body": "{{$trigger.body}}"
      },
      "resolve": null,
      "reject": "notify_failure"
    },
    {
      "identifier": "notify_failure",
      "name": "Notify failure",
      "key": "notify_failure",
      "type": "trigger",
      "position_x": 37,
      "position_y": 17,
      "options": {
        "flow": "failure-notification",
        "payload": {
          "flow": "Review queue actions",
          "error": "{{$last}}"
        }
      }
    }
  ]
}
