{
  "name": "Record public_id alias",
  "icon": "alternate_email",
  "color": "#5B2D8E",
  "description": "Admin-only: when public_id changes, write public_id_aliases so saved My list entries keep working.",
  "status": "active",
  "accountability": "all",
  "trigger": "event",
  "options": {
    "type": "filter",
    "scope": ["items.update"],
    "collections": ["organizations"]
  },
  "operation": "request_alias",
  "operations": [
    {
      "identifier": "request_alias",
      "name": "Write alias",
      "key": "request_alias",
      "type": "request",
      "position_x": 19,
      "position_y": 17,
      "options": {
        "method": "POST",
        "url": "http://operations:8790/public-id-alias",
        "body": {
          "key": "{{$trigger.keys[0]}}",
          "newPublicId": "{{$trigger.payload.public_id}}",
          "entityType": "organization"
        }
      },
      "resolve": null,
      "reject": "notify_failure"
    },
    {
      "identifier": "notify_failure",
      "name": "Notify failure",
      "key": "notify_failure",
      "type": "trigger",
      "position_x": 37,
      "position_y": 17,
      "options": {
        "flow": "failure-notification",
        "payload": {
          "flow": "Record public_id alias",
          "error": "{{$last}}"
        }
      }
    }
  ]
}
