{
  "name": "Sticky curation on save",
  "icon": "save",
  "color": "#5B2D8E",
  "description": "When an editor saves ordinary fields on an FSD record, upsert one overrides patch row. Editors never type JSON.",
  "status": "active",
  "accountability": "all",
  "trigger": "event",
  "options": {
    "type": "action",
    "scope": ["items.update"],
    "collections": ["services", "organizations"]
  },
  "operation": "request_sticky",
  "operations": [
    {
      "identifier": "request_sticky",
      "name": "Upsert override",
      "key": "request_sticky",
      "type": "request",
      "position_x": 19,
      "position_y": 17,
      "options": {
        "method": "POST",
        "url": "http://operations:8790/sticky-curation",
        "body": "{{$trigger}}"
      },
      "resolve": null,
      "reject": "notify_failure"
    },
    {
      "identifier": "notify_failure",
      "name": "Notify failure",
      "key": "notify_failure",
      "type": "trigger",
      "position_x": 37,
      "position_y": 17,
      "options": {
        "flow": "failure-notification",
        "payload": {
          "flow": "Sticky curation on save",
          "error": "{{$last}}"
        }
      }
    }
  ]
}
