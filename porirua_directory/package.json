{
  "name": "porirua-directory",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/run-node-tests.mjs",
    "test:unit": "node scripts/run-node-tests.mjs unit",
    "test:db": "node --test --test-concurrency=1 tests/db-*.test.mjs",
    "test:directus": "node scripts/run-node-tests.mjs directus",
    "test:sync": "node --test --test-concurrency=1 tests/fsd-sync-run.test.mjs tests/fsd-sync-diff.test.mjs tests/fsd-sync-collapse.test.mjs",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down",
    "db:sync-test:up": "docker compose -p weekly-fsd-sync-l2yyxlzr -f docker-compose.sync-test.yml up -d --wait",
    "db:sync-test:down": "docker compose -p weekly-fsd-sync-l2yyxlzr -f docker-compose.sync-test.yml down",
    "directus:up": "docker compose -p porirua-directus -f docker-compose.directus.yml up -d --wait",
    "directus:down": "docker compose -p porirua-directus -f docker-compose.directus.yml down -v",
    "directus:reset": "npm run directus:down && npm run directus:up",
    "directus:bootstrap": "node scripts/directus/bootstrap.mjs",
    "payload:dev": "npm run dev --prefix payload",
    "payload:up": "docker compose -p porirua-payload -f docker-compose.payload.yml up -d --wait",
    "payload:down": "docker compose -p porirua-payload -f docker-compose.payload.yml down -v",
    "db:import": "node scripts/db-import-from-json.mjs",
    "catalog:publish": "node scripts/publish-catalog.mjs",
    "sync:fsd": "node scripts/fsd-sync-run.mjs",
    "review:approve": "node scripts/approve-review.mjs",
    "import:fsd": "node scripts/fsd-import.mjs",
    "merge:services": "node scripts/merge-services.mjs",
    "build:data": "npm run import:fsd && npm run merge:services",
    "test:e2e": "playwright test",
    "test:e2e:dev": "BASE_URL=https://directory-dev.bsky.nz playwright test",
    "test:e2e:dev:publish": "RUN_DEV_E2E=1 BASE_URL=https://directory-dev.bsky.nz playwright test e2e/dev-studio.spec.js",
    "test:e2e:payload": "playwright test e2e/payload-directory-editor.spec.js",
    "serve": "python3 -m http.server 5173",
    "start:api": "node api/server.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "csv-parse": "^5.6.0"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
